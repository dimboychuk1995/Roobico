{
  "expo": {
    "name": "Roobico",
    "slug": "roobico-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roobico",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.roobico.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Roobico uses the camera to scan VIN barcodes and plates, attach photos to work orders, and scan paper work orders and vendor invoices.",
        "NSPhotoLibraryUsageDescription": "Roobico uses your photo library to attach existing photos to work orders and units."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16A34A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16a34a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f040674-c32b-42af-920c-eaf36ae426e4"
      }
    },
    "owner": "holmes_0003"
  }
}
